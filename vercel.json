{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/evening",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 13 * * 0"
    },
    {
      "path": "/api/cron/monthly",
      "schedule": "0 3 1 * *"
    }
  ]
}

# ---- App ----
# Public URL of the deployed app (no trailing slash). Used in email links and by QStash.
APP_URL=https://remindo.vercel.app
APP_TIMEZONE=Asia/Kolkata
# Name shown in the greeting (optional)
# NEXT_PUBLIC_OWNER_NAME=Hashir
# Passcode you type to unlock the dashboard.
APP_PASSCODE=change-me
# Random strings: run `openssl rand -base64 32` for each.
AUTH_SECRET=
CRON_SECRET=

# ---- Database (Neon) ----
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ---- Email (Resend) ----
RESEND_API_KEY=re_xxx
# Where reminders go. With the default sender this must be your Resend account email.
NOTIFY_EMAIL=hashirpanwer@gmail.com
# Optional once you verify a domain in Resend:
# EMAIL_FROM=Remindo <reminders@yourdomain.com>

# ---- Exact-time delivery (Upstash QStash) ----
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Only if your QStash console shows a regional URL:
# QSTASH_URL=https://qstash.upstash.io

# ---- AI parsing (at least one; falls back to a simple parser without) ----
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# ---- Optional tuning ----
# ALL_DAY_TIME=09:00          # when all-day reminders (birthdays, bills) alert
# ESCALATE_AFTER_MIN=30       # re-send unacknowledged high-priority reminders after this
# MAX_ESCALATIONS=2
